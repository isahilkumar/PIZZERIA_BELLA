PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pizzeria_bella?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@pizzadelivery.com

# Razorpay Test Credentials
RAZORPAY_KEY_ID=rzp_test_YourKeyId
RAZORPAY_KEY_SECRET=YourKeySecret

# Default Inventory Stock Threshold
DEFAULT_STOCK_THRESHOLD=20

# Node-Cron Schedule (e.g. every 30 minutes)
CRON_SCHEDULE=*/30 * * * *

# Nodemailer Email Configuration
# Mode: ethereal (sandbox) or gmail / custom
EMAIL_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="Pizzeria Bella Kitchen" <your_email@gmail.com>

# ============================================================================
# SMS Gateway Options for Real Phone SMS Delivery
# Option 1: Fast2SMS (Free India Quick OTP - https://www.fast2sms.com)
# FAST2SMS_API_KEY=your_fast2sms_api_key

# Option 2: Twilio Global SMS (https://www.twilio.com)
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_PHONE_NUMBER=+1234567890

# Option 3: 2Factor.in (India OTP Gateway - https://2factor.in)
# TWOFACTOR_API_KEY=your_2factor_api_key

